{
  "name": "candy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "tui": "npm run build && node apps/tui/dist/main.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:boundaries && npm run check:pi-versions && npm run check:lifecycle-scripts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:lifecycle-scripts": "node scripts/check-lifecycle-scripts.mjs",
    "check:pi-versions": "node scripts/check-pi-versions.mjs",
    "check:toolchain": "node scripts/assert-toolchain.mjs",
    "check:windows-toolchain": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows-toolchain.ps1",
    "check:native": "node scripts/check-native.mjs",
    "smoke:sandbox:macos": "npm run build && node scripts/smoke-sandbox-macos.mjs",
    "smoke:credential-manager:windows": "npm run build && node scripts/smoke-credential-manager-windows.mjs",
    "smoke:credential-manager:packaged:windows": "node scripts/smoke-credential-manager-packaged-windows.mjs",
    "smoke:native:windows": "npm run build && node scripts/smoke-native-windows.mjs",
    "smoke:recovery:windows": "npm run build && node scripts/smoke-recovery-windows.mjs",
    "smoke:long-running:windows": "npm run build && node scripts/smoke-long-running-windows.mjs",
    "smoke:long-running:macos": "npm run build && node scripts/smoke-long-running-macos.mjs",
    "smoke:attachment-recovery:windows": "npm run build && node scripts/smoke-attachment-recovery-windows.mjs",
    "smoke:cross-client:windows": "npm run build && node scripts/smoke-cross-client-windows.mjs",
    "smoke:concurrency:windows": "npm run build && node scripts/smoke-concurrency-windows.mjs",
    "measure:windows:responsiveness": "npm run build && node scripts/measure-windows-responsiveness.mjs",
    "acceptance:windows": "npm run build && node scripts/acceptance-windows.mjs",
    "acceptance:macos": "npm run build && node scripts/acceptance-macos.mjs",
    "acceptance:macos:baseline": "npm run build && node scripts/acceptance-macos.mjs --baseline",
    "gate:live:deepseek": "node scripts/live-provider-gate.mjs --provider deepseek --confirm-live",
    "gate:live:minimax": "node scripts/live-provider-gate.mjs --provider minimax-cn --confirm-live",
    "dev:import:opencode:deepseek": "npm run build && node scripts/import-opencode-deepseek.mjs",
    "format": "prettier --write package.json tsconfig.json tsconfig.base.json eslint.config.js .prettierrc.json .github scripts apps packages fixtures",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.base.json eslint.config.js .prettierrc.json .github scripts apps packages fixtures",
    "lint": "eslint apps packages scripts",
    "smoke:tui": "npm run build && node apps/tui/dist/main.js --smoke",
    "smoke:tui-task": "npm run build && node apps/tui/dist/main.js --smoke-task",
    "smoke:tui:journey:macos": "npm run build && node scripts/smoke-tui-journey-macos.mjs",
    "smoke:tui:terminal:macos": "npm run build && node scripts/smoke-tui-terminal-matrix-macos.mjs",
    "smoke:tui:trusted-shell:macos": "npm run build && node scripts/smoke-tui-trusted-shell-macos.mjs",
    "smoke:tui:trusted-shell:dogfood:macos": "npm run build && node scripts/smoke-tui-trusted-shell-dogfood-macos.mjs",
    "smoke:runtime-session-remap": "npm run build && node scripts/smoke-runtime-session-remap.mjs",
    "smoke:recovery:macos": "npm run build && node scripts/smoke-recovery-macos.mjs",
    "smoke:app-server": "npm run build && node scripts/smoke-app-server.mjs",
    "smoke:safe-edit": "npm run build && node scripts/smoke-safe-edit.mjs",
    "smoke:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "package:desktop:macos": "npm run build && node scripts/package-desktop-macos.mjs",
    "package:desktop:windows": "npm run build && node scripts/package-desktop-windows.mjs",
    "package:desktop:windows:release": "npm run build && node scripts/package-desktop-windows-release.mjs",
    "verify:desktop:windows:release": "node scripts/verify-windows-release.mjs",
    "smoke:desktop:packaged": "npm run package:desktop:macos && node scripts/smoke-desktop-packaged.mjs && node scripts/smoke-packaged-keychain.mjs",
    "smoke:desktop:packaged:recovery:macos": "npm run package:desktop:macos && node scripts/smoke-recovery-macos.mjs --packaged",
    "smoke:desktop:packaged:handoff:macos": "npm run package:desktop:macos && node scripts/smoke-desktop-packaged-handoff-macos.mjs",
    "smoke:desktop:packaged:long-running:macos": "npm run package:desktop:macos && node scripts/smoke-desktop-packaged-long-running-macos.mjs",
    "smoke:desktop:packaged:credential-isolation:macos": "npm run package:desktop:macos && node scripts/smoke-desktop-packaged-credential-isolation-macos.mjs",
    "smoke:desktop:packaged:coding-journey:macos": "npm run package:desktop:macos && node scripts/smoke-desktop-packaged-coding-journey-macos.mjs",
    "smoke:browser:macos": "npm run package:desktop:macos && node scripts/smoke-browser-macos.mjs",
    "measure:macos:responsiveness": "npm run build && node scripts/measure-macos-responsiveness.mjs",
    "smoke:desktop:packaged:windows": "npm run package:desktop:windows && node scripts/smoke-desktop-packaged-windows.mjs",
    "smoke:desktop:packaged:recovery:windows": "npm run package:desktop:windows && node scripts/smoke-desktop-packaged-recovery-windows.mjs",
    "smoke:desktop:packaged:handoff:windows": "npm run package:desktop:windows && node scripts/smoke-desktop-packaged-handoff-windows.mjs",
    "smoke:desktop:packaged:long-running:windows": "npm run package:desktop:windows && node scripts/smoke-desktop-packaged-long-running-windows.mjs",
    "smoke:desktop:packaged:credential-isolation:windows": "npm run package:desktop:windows && node scripts/smoke-desktop-packaged-credential-isolation-windows.mjs",
    "smoke:desktop:packaged:coding-journey:windows": "npm run package:desktop:windows && node scripts/smoke-desktop-packaged-coding-journey-windows.mjs",
    "smoke:browser:windows": "npm run package:desktop:windows && node scripts/smoke-browser-windows.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-client": "0.84.1",
    "@earendil-works/pi-protocol": "0.84.1",
    "@earendil-works/pi-telemetry": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1"
  }
}
