log_user 0
set timeout 30
log_file -a $env(CANDY_TERMINAL_MATRIX_PTY_LOG)

proc fail {message} {
  puts stderr "TUI terminal matrix failed: $message"
  exit 1
}

proc send_command {value} {
  send -- "$value\r"
}

proc wait_for {pattern description} {
  expect {
    -re $pattern {}
    timeout { fail "timed out waiting for $description" }
    eof { fail "TUI exited while waiting for $description" }
  }
}

cd $env(CANDY_TERMINAL_MATRIX_LAUNCH_DIR)
spawn -noecho $env(CANDY_TERMINAL_MATRIX_NODE) $env(CANDY_TERMINAL_MATRIX_CHILD)

if {$env(CANDY_TERMINAL_MATRIX_MODE) == "startup-failure"} {
  expect eof
} else {
  wait_for {Ask Candy} "usable TUI input"
}

if {$env(CANDY_TERMINAL_MATRIX_MODE) == "normal"} {
  send_command "中文输入测试"
  wait_for {terminal-matrix-first-ok} "Chinese input task"
  send_command ":new"
  wait_for {new task ready} "paste task"
  send -- "\033\[200~粘贴内容\n第二行\033\[201~\r"
  wait_for {terminal-matrix-paste-ok} "bracketed paste task"
  send_command "/model"
  wait_for {Available models} "bare /model model list"
  wait_for {deepseek-flash} "bare /model model choices"
  send_command "/resume"
  wait_for {no paused or interrupted tasks to resume} "bare /resume empty list"
  send_command "/cancel"
  wait_for {usage: /cancel <task-id>} "bare /cancel usage guard"
  send_command "/help"
  wait_for {/resume <task-id> <continuation>} "/help resume usage"
  wait_for {/quit — Exit Candy} "/help quit entry"
  stty rows 40 columns 120
  send -- "\033\[8;40;120t"
  send_command ":quit"
  expect eof
} elseif {$env(CANDY_TERMINAL_MATRIX_MODE) == "runtime-failure"} {
  send_command "runtime failure fixture"
  wait_for {interrupted: workspace runtime failure fixture} "runtime failure recovery"
  send_command ":quit"
  expect eof
} elseif {$env(CANDY_TERMINAL_MATRIX_MODE) == "cancel"} {
  send_command "cancel fixture"
  wait_for {created (task-[a-z0-9]+)[[:space:]]+\(queued\)} "cancel task creation"
  send -- "\003"
  expect eof
} elseif {$env(CANDY_TERMINAL_MATRIX_MODE) == "startup-failure"} {
  # The process already exited above after Candy's startup safety check.
} else {
  fail "unknown terminal matrix mode"
}
